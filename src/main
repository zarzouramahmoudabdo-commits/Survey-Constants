import './style.css'

document.querySelector('#app').innerHTML = `
  <div class="app">

    <header class="topbar">
      <div>
        <div class="brand">SURVEY CONSTANTS</div>
        <div class="subtitle">Mahmoud Zarzoura</div>
      </div>
      <div class="status">OFFLINE</div>
    </header>

    <main class="content">

      <section class="welcome">
        <h1>ثوابت X / Y</h1>
        <p>إدارة والبحث في الثوابت المساحية</p>
      </section>

      <section class="search-box">
        <input
          id="searchInput"
          type="search"
          placeholder="ابحث برقم الثابت أو الوصف أو رقم الفيلا"
        />
      </section>

      <section class="actions">
        <button id="addBtn" class="primary-btn">
          ➕ إضافة ثابت X / Y
        </button>

        <button id="backBtn" class="secondary-btn">
          ← رجوع
        </button>
      </section>

      <section id="constantsList" class="constants-list"></section>

    </main>

    <footer>
      Survey Constants © 2026
    </footer>

  </div>
`

let constants = [
  {
    id: 'XY-001',
    description: 'ثابت مساحي رئيسي',
    villa: '101',
    x: '1000.000',
    y: '2000.000'
  },
  {
    id: 'XY-002',
    description: 'ثابت حدود',
    villa: '102',
    x: '1100.000',
    y: '2100.000'
  }
]

const list = document.getElementById('constantsList')
const searchInput = document.getElementById('searchInput')

function renderConstants(items = constants) {
  if (items.length === 0) {
    list.innerHTML = `
      <div class="empty">
        لا توجد ثوابت مطابقة للبحث
      </div>
    `
    return
  }

  list.innerHTML = items.map(item => `
    <article class="constant-card">

      <div class="constant-header">
        <strong>${item.id}</strong>
        <span>فيلا ${item.villa}</span>
      </div>

      <div class="description">
        ${item.description}
      </div>

      <div class="coordinates">
        <div>
          <small>X</small>
          <strong>${item.x}</strong>
        </div>

        <div>
          <small>Y</small>
          <strong>${item.y}</strong>
        </div>
      </div>

      <div class="card-actions">
        <button onclick="editConstant('${item.id}')">
          ✏️ تعديل
        </button>

        <button onclick="deleteConstant('${item.id}')">
          🗑️ حذف
        </button>
      </div>

    </article>
  `).join('')
}

searchInput.addEventListener('input', () => {
  const query = searchInput.value.trim().toLowerCase()

  const filtered = constants.filter(item =>
    item.id.toLowerCase().includes(query) ||
    item.description.toLowerCase().includes(query) ||
    item.villa.toLowerCase().includes(query) ||
    item.x.toLowerCase().includes(query) ||
    item.y.toLowerCase().includes(query)
  )

  renderConstants(filtered)
})

document.getElementById('addBtn').onclick = () => {
  const id = prompt('رقم / كود الثابت:')
  if (!id) return

  const description = prompt('وصف الثابت:')
  if (!description) return

  const villa = prompt('رقم الفيلا:')
  if (!villa) return

  const x = prompt('قيمة X:')
  if (!x) return

  const y = prompt('قيمة Y:')
  if (!y) return

  constants.push({
    id,
    description,
    villa,
    x,
    y
  })

  renderConstants()
}

window.deleteConstant = (id) => {
  const confirmed = confirm('هل تريد حذف هذا الثابت؟')

  if (!confirmed) return

  constants = constants.filter(item => item.id !== id)

  renderConstants()
}

window.editConstant = (id) => {
  const item = constants.find(item => item.id === id)

  if (!item) return

  const description = prompt('الوصف:', item.description)
  if (description === null) return

  const villa = prompt('رقم الفيلا:', item.villa)
  if (villa === null) return

  const x = prompt('قيمة X:', item.x)
  if (x === null) return

  const y = prompt('قيمة Y:', item.y)
  if (y === null) return

  item.description = description
  item.villa = villa
  item.x = x
  item.y = y

  renderConstants()
}

document.getElementById('backBtn').onclick = () => {
  location.reload()
}

renderConstants()
